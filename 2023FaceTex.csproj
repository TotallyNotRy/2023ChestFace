<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable> 

		<!-- Add debug symbols which are useful for debugging later. This points out line numbers of
		errors to you inside of your log file. -->
		<DebugType Condition="'$(Configuration)'=='Debug'">embedded</DebugType>
		
		<!-- Allow usage of assembly publicizers-->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="HarmonyLib">
			<HintPath>$(BepInExAssemblyPath)\0Harmony.dll</HintPath>
		</Reference>
		<Reference Include="BepInEx">
			<HintPath>$(BepInExAssemblyPath)\BepInEx.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="$(GameAssemblyPath)\*.dll" Exclude="$(GameAssemblyPath)\Assembly_CSharp.dll;$(GameAssemblyPath)\mscorlib.dll;$(GameAssemblyPath)\System*.dll;$(GameAssemblyPath)\netstandard.dll">
			<HintPath>%(Identity)</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="gorillachestface.png">
		  <LogicalName>2023FaceTex.gorillachestface.png</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="gorillatexture.png">
			<LogicalName>2023FaceTex.gorillatexture.png</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="lightfur.png">
			<LogicalName>2023FaceTex.lightfur.png</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="lightfurPaintBall.png">
			<LogicalName>2023FaceTex.lightfurPaintBall.png</LogicalName>
		</EmbeddedResource>
	</ItemGroup>
</Project>